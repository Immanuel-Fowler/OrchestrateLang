head<T>(items: T[]) -> option<T>
tail<T>(items: T[]) -> T[]
reverse<T>(items: T[]) -> T[]
sort<T>(items: T[]) -> T[]
unique<T>(items: T[]) -> T[]
flatten<T>(lists: T[][]) -> T[]
sum(items: int[]) -> int
max(items: int[]) -> int
min(items: int[]) -> int
sum_float(items: float[]) -> float
max_float(items: float[]) -> float
min_float(items: float[]) -> float
