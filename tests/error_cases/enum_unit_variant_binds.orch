// A unit variant carries nothing, so a pattern cannot bind from it. This used to reach
// rustc as "expected tuple struct or tuple variant, found unit variant".
enum Signal { Stop, Go }

orchestrator main() {
    let s = Signal::Stop
    match s {
        Signal::Stop(reason) => print(reason),
        Signal::Go => print("go")
    }
    stop_orch()
}
