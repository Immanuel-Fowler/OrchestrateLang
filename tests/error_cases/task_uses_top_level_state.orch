// Top-level state belongs to the instance and only hooks reach it. A task is generated
// beside it, so this used to reach rustc as "cannot find value `counter` in this scope".
serverlet Counter {
    let n = 0
    on add(k: int) -> int {
        n = n + k
        return n
    }
}

let counter = start Counter()

task bump(k: int) -> int {
    return counter.add(k)
}

orchestrator main() {
    print(to_string(bump(1)))
    stop_orch()
}
