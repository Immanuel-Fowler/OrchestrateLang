        let (__kind, __payload) = match __result {
            Ok(Ok(value)) => (ORCH_KIND_REPLY, value),
            Ok(Err(message)) => (ORCH_KIND_ERROR, __wire_to_bytes(&message)),
            Err(e) => (ORCH_KIND_ERROR, __wire_to_bytes(&__panic_message(&e))),
        };
        if __frame_write(&mut __writer, __kind, __frame.call_id, &__payload).is_err() { break; }
    }
}
