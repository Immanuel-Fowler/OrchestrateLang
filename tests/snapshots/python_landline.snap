            let python = std::env::var_os("ORCH_PYTHON").unwrap_or_else(|| "python3".into());
            let __spawned = tokio::process::Command::new(python)
                .arg("-u").arg(directory.join("main.py"))
                .kill_on_drop(true)
                .stdin(std::process::Stdio::piped())
                .stdout(std::process::Stdio::piped()).spawn();
            let __startup: Result<_, String> = async {
                let mut __child = __spawned.map_err(|e| format!("cannot start Python landline: {}", e))?;
                let mut __cin = __child.stdin.take().expect("child stdin");
                let mut __cout = __child.stdout.take().expect("child stdout");
                let handshake = async {
                let hello = __secret_read_frame(&mut __cout).await.map_err(|e| e.to_string())?.ok_or("process exited before HELLO")?;
                if hello.kind != ORCH_KIND_HELLO || hello.call_id != 0 { return Err("expected HELLO".into()); }
                let mut pos = 0;
                let version = i64::wire_decode(&hello.payload, &mut pos).ok_or("invalid protocol version")?;
                let signatures = Vec::<String>::wire_decode(&hello.payload, &mut pos).ok_or("invalid handler signatures")?;
                if version != ORCH_WIRE_VERSION || pos != hello.payload.len() {
                    return Err(format!("protocol mismatch: this program speaks protocol {}, the landline's SDK sent protocol {}", ORCH_WIRE_VERSION, version));
                }
                // Each declared handler is found by name, so the source may define methods the
                // program does not call, in any order. A call names the handler by its place
                // in the source's list.
                let expected: Vec<String> = vec!["add(int)->int".to_string()];
                let mut __remote = Vec::with_capacity(expected.len());
                for want in &expected {
                    let name = want.split('(').next().unwrap_or(want);
                    match signatures.iter().position(|got| got.split('(').next() == Some(name)) {
                        Some(index) if signatures[index] == *want => __remote.push(index as i64),
                        Some(index) => return Err(format!("interface mismatch: handler '{}' is declared as {} but the source defines {}", name, want, signatures[index])),
                        None => return Err(format!(
                            "interface mismatch: handler '{}' is declared as {} but the source defines no method '{}'; it defines {}",
                            name, want, name, if signatures.is_empty() { "none".to_string() } else { signatures.join(", ") }
                        )),
                    }
                }
                __secret_write_frame(&mut __cin, ORCH_KIND_READY, 0, &[]).await.map_err(|e| e.to_string())?;
                Ok::<Vec<i64>, String>(__remote)
            };
                match tokio::time::timeout(std::time::Duration::from_secs(10), handshake).await {
                    Ok(Ok(__remote)) => Ok((__child, __cin, __cout, __remote)),
                    Ok(Err(error)) => { let _ = __child.kill().await; Err(error) }
                    Err(_) => { let _ = __child.kill().await; Err("no handshake within 10 s".to_string()) }
                }
            }.await;
            let (mut __child, mut __cin, mut __cout, __remote) = match __startup {
                Ok(started) => { __failed_starts = 0; __orch_child("Counter", started.0.id()); started }
                Err(__error) => {
                    // Not closed for good: calls fail — a `result` handler answers `err`, any
                    // other its default — until the next try, which comes sooner than a
                    // caller would give up waiting.
                    __failed_starts += 1;
                    let __delay = (100u64 << __failed_starts.min(6)).min(5000);
                    eprintln!("[orchestrate] landline 'Counter' startup failed: {}; calls fail until it is tried again in {} ms", __error, __delay);
                    let __retry_at = std::time::Instant::now() + std::time::Duration::from_millis(__delay);
                    loop {
                        let __wait = __retry_at.saturating_duration_since(std::time::Instant::now());
                        match tokio::time::timeout(__wait, async { rx.recv().await }).await {
                            Err(_) => continue 'restart,
                            Ok(None) => break 'restart,
                            Ok(Some(msg)) => match msg {
                                CounterMsg::Add { reply_to, .. } => { let _ = reply_to.send(Default::default()); }
                            },
                        }
                    }
                }
            };
            while let Some(msg) = rx.recv().await {
                match msg {
                    CounterMsg::Add { n, reply_to } => {
                
                __next_call = __next_call.wrapping_add(1);
                let mut __payload = Vec::new();
                
                __remote[0].wire_encode(&mut __payload);
                n.wire_encode(&mut __payload);
                let __result: Result<_, String> = async {
                    __secret_write_frame(&mut __cin, ORCH_KIND_CALL, __next_call, &__payload).await.map_err(|e| e.to_string())?;
                    let f = __secret_read_frame(&mut __cout).await.map_err(|e| e.to_string())?.ok_or("process exited")?;
                    if f.call_id != __next_call { return Err("reply call id mismatch".into()); }
                    if f.kind == ORCH_KIND_ERROR {
                        let mut pos = 0;
                        let error = String::wire_decode(&f.payload, &mut pos).ok_or("invalid error reply")?;
                        eprintln!("[orchestrate] landline 'Counter' handler 'add' failed: {}", error);
                        return Ok(Default::default());
                    }
                    if f.kind != ORCH_KIND_REPLY { return Err("expected REPLY".into()); }
                    Ok({ let mut pos = 0; let value = <i64 as OrchWire>::wire_decode(&f.payload, &mut pos).ok_or("invalid reply value")?; if pos != f.payload.len() { return Err("trailing reply data".to_string()); } value })
                }.await;
                match __result {
                    Ok(value) => {  let _ = reply_to.send(value); },
                    Err(__error) => {
                        eprintln!("[orchestrate] landline 'Counter' crashed: {}", __error);
                        let _ = __child.kill().await;
                        __orch_child("Counter", None);
                        
                        let _ = reply_to.send(Default::default());
                        continue 'restart;
                    }
                }
            }
                }
            }
            let _ = __secret_write_frame(&mut __cin, ORCH_KIND_BYE, 0, &[]).await;
            drop(__cin);
            if tokio::time::timeout(std::time::Duration::from_secs(2), __child.wait()).await.is_err() {
                let _ = __child.kill().await;
            }
            __orch_child("Counter", None);
            break;
        }
    });
    CounterClient { tx, latest, actor }
}


