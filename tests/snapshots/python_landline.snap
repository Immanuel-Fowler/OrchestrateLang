#[derive(Debug)]
pub enum CounterMsg {
    Add { n: i64, reply_to: tokio::sync::oneshot::Sender<i64> },
}

#[derive(Default, Debug)]
pub struct CounterLatest {
    add: std::sync::Mutex<Option<i64>>,
}

#[derive(Clone, Debug)]
pub struct CounterClient {
    tx: tokio::sync::mpsc::Sender<CounterMsg>,
    actor: __OrchActor,
    latest: std::sync::Arc<CounterLatest>,
}

impl CounterClient {
    pub async fn add(&self, n: i64) -> i64 {
        let (reply_tx, reply_rx) = tokio::sync::oneshot::channel();
        let _ = self.tx.send(CounterMsg::Add { n, reply_to: reply_tx }).await;
        self.actor.reply(reply_rx).await.unwrap_or_default()
    }
}

#[allow(non_snake_case)]
pub fn start_Counter() -> CounterClient {
    let (tx, mut rx) = tokio::sync::mpsc::channel::<CounterMsg>(100);
    let __latest = std::sync::Arc::new(CounterLatest::default());
    let latest = __latest.clone();
    let actor = __OrchActor::spawn(true, async move {
        let directory = crate::__orch_children_dir().join("landline_Counter");
        let mut __next_call = 0u32;
        // Consecutive starts that failed. Each waits longer before the next try, and the
        // calls that arrive meanwhile are answered with their default.
        let mut __failed_starts = 0u32;
