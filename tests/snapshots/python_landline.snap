    w.write_all(&[kind]).await?;
    w.write_all(&call_id.to_le_bytes()).await?;
    w.write_all(payload).await?;
    w.flush().await
}

async fn __secret_read_frame<R: tokio::io::AsyncReadExt + Unpin>(r: &mut R) -> std::io::Result<Option<OrchFrame>> {
