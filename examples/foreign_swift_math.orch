// Requires Swift 5.10+ on PATH (Xcode or https://www.swift.org/install/).
use module stats: "./modules/foreign_swift_math"

let worker = automatic {
    print("Mean of 2, 4, 9: " + to_string(stats.mean3(2.0, 4.0, 9.0)))
    print("Clamp 150 to 0..100: " + to_string(stats.clamp_int(150, 0, 100)))
    print("2024 is a leap year: " + to_string(stats.is_leap_year(2024)))

    stop_orch()
}

orchestrator main(procs: process[worker]) { }
